NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Partner / doctors host. Used to build /dr/<slug> QR-code links in the admin.
# Changing this changes every NEWLY generated QR code, so keep it stable once printed.
NEXT_PUBLIC_SITE_URL=https://partners.gutguard.ph
NEXT_PUBLIC_PARTNERS_HOST=partners.gutguard.ph

# Canonical public website origin. Used by metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_MARKETING_URL=https://gutguard.ph

# Shop host. Used for Maya redirect URLs and order-page links. Must be the origin the
# shop is actually served from. Falls back to the request origin when unset.
NEXT_PUBLIC_SHOP_URL=https://shop.gutguard.ph

# Hostname only (no scheme). next.config.ts redirects "/" to "/shop" on this host so
# shoppers do not land on the partner registration page.
NEXT_PUBLIC_SHOP_HOST=shop.gutguard.ph

# ─── Schema layout (GutGuard LifeStyle project) ────────────────────────────────
# One codebase serves both systems. Production uses `doctors`; the mirror at
# sandbox.gutguard.ph sets this to `sandbox` so identical code reads and writes the
# `sandbox` Postgres schema instead. doctor_registrations stays shared in `doctors`,
# so referral links work with real partner slugs on both.
NEXT_PUBLIC_SHOP_DB_SCHEMA=doctors

# The sandbox deployment (Vercel Preview env on the `sandbox` branch) overrides:
#   NEXT_PUBLIC_SHOP_DB_SCHEMA=sandbox
#   NEXT_PUBLIC_SHOP_URL=https://sandbox.gutguard.ph
#   NEXT_PUBLIC_SHOP_HOST=sandbox.gutguard.ph
#   MAYA_API_BASE=https://pg-sandbox.paymaya.com
#   MAYA_PUBLIC_KEY / MAYA_SECRET_KEY = the sandbox keys
#   MAYA_WEBHOOK_IPS=13.229.160.234,3.1.199.75
# Supabase function secret for the mirror's order links:
#   SHOP_SANDBOX_SITE_URL=https://sandbox.gutguard.ph

# Maya Checkout API. Server-only, set in Vercel (not NEXT_PUBLIC_*).
# Sandbox base: https://pg-sandbox.paymaya.com | Production: https://pg.paymaya.com
MAYA_API_BASE=https://pg-sandbox.paymaya.com
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
# Optional webhook IP allowlist (comma separated). Leave unset to skip the network check;
# the handler already re-fetches every payment from Maya with the secret key.
# Sandbox: 13.229.160.234,3.1.199.75 | Production: 18.138.50.235,3.1.207.200
MAYA_WEBHOOK_IPS=

# Service role key, server-only. Used by /api/maya/* to write payment state.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function secrets, set in Supabase, not Vercel:
# RESEND_API_KEY=
# PROPOSAL_FROM_EMAIL=GutGuard Doctors <hello@yourdomain.com>
# PROPOSAL_PDF_URL=https://your-vercel-domain.vercel.app/GutGuard_Doctor_TikTok_Proposal.pdf
# SHOP_ORDER_FROM_EMAIL=GutGuard Orders <orders@yourdomain.com>
# SHOP_ORDER_REPLY_TO=orders@yourdomain.com
# SHOP_SITE_URL=https://your-vercel-domain.vercel.app

# SMS blast provider, set as Supabase Edge Function secrets:
# SMS_PROVIDER=itexmo
# ITEXMO_EMAIL=
# ITEXMO_PASSWORD=
# ITEXMO_API_CODE=
# ITEXMO_SENDER_ID=GutGuard
# ITEXMO_SMS_.itexmo.com/api/broadcast

# TikTok Shop admin order lookup, set as Supabase Edge Function secrets:
# TIKTOK_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
# TIKTOK_SHOP_AUTH_BASE_URL=https://auth.tiktok-shops.com
# TIKTOK_SHOP_API_VERSION=202309
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=
# TIKTOK_SHOP_SHOP_CIPHER=
# Store rotating access_token, refresh_token, and expires_at in public.tiktok_credentials.

# ─── Partner dashboard (/partner) ──────────────────────────────────────────────
# No new variables. Sign-in is Supabase Auth email OTP, matched against the email on
# doctor_registrations, so it needs dashboard configuration rather than env:
#   Auth -> Email Templates -> Magic Link: the body MUST include {{ .Token }}, or the
#     mail arrives with a link and no 6-digit code for the partner to type.
#   Auth -> SMTP: point at Resend (RESEND_API_KEY above). The built-in sender throttles
#     at roughly 30 mails/hour project-wide, which presents as a broken login.
